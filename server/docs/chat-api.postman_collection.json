{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Chat API",
    "description": "REST collection for the Chat server (`Express + Mongoose`).\n\n**Auth:** protected routes accept `Authorization: Bearer <accessToken>` or the signed `chat_at` cookie. Register / Login / Refresh also set `chat_at` (access) and `chat_rt` (refresh) cookies. Passwords must be at least 8 characters and include a letter and a number.\n\n**IDs** are Mongo ObjectIds (24 hex chars). Invalid ids return 422 `VALIDATION_ERROR`. Non-members receive 404 (not 403) for conversations, messages, and groups.\n\n**Suggested runner order**\n1. Register (Alice) then Register Peer (Bob)\n2. Send Friend Request → Accept Friend Request (uses `peerAccessToken`)\n3. Create Direct Conversation → Send Message\n4. Create Group (memberIds = peer)\n\nError envelope: `{ success: false, message, code, details? }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Current user's access JWT. Set by Register / Login / Refresh."
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "Refresh JWT. Set by Register / Login / Refresh."
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "Authenticated user id (Alice)."
    },
    {
      "key": "peerUserId",
      "value": "",
      "type": "string",
      "description": "Other user id (Bob). Used for friends, DMs, and group members. Never the current user."
    },
    {
      "key": "peerAccessToken",
      "value": "",
      "type": "string",
      "description": "Bob's access token. Used to accept friend requests."
    },
    {
      "key": "friendRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "groupId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            },
            "description": "Process liveness. No auth. Returns 200 if the Node process is up."
          },
          "response": [
            {
              "name": "Live",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"status\":\"live\"}}"
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Readiness probe. Returns 200 when MongoDB is connected, otherwise 503."
          },
          "response": [
            {
              "name": "Ready",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"status\":\"ready\",\"db\":\"ok\"}}"
            },
            {
              "name": "503 Database not ready",
              "status": "Service Unavailable",
              "code": 503,
              "body": "{\"success\":false,\"message\":\"Database not ready.\",\"code\":\"INTERNAL_ERROR\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates an account. Returns `accessToken`, `refreshToken`, and `user`. Sets signed httpOnly cookies. Rate-limited. Password: min 8 chars, at least one letter and one number."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\"success\":true,\"data\":{\"accessToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"refreshToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"user\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"email\":\"alice@example.com\",\"username\":\"alice.a1b2c3\",\"bio\":\"\",\"avatar\":\"\",\"coverUrl\":\"\",\"status\":\"online\"},\"message\":\"Registration successful.\"}}"
            },
            {
              "name": "409 Email taken",
              "status": "Conflict",
              "code": 409,
              "body": "{\"success\":false,\"message\":\"User with this email already exists.\",\"code\":\"CONFLICT\"}"
            },
            {
              "name": "422 Validation",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\"success\":false,\"message\":\"Invalid request payload\",\"code\":\"VALIDATION_ERROR\",\"details\":[{\"path\":\"password\",\"message\":\"Password must be at least 8 characters.\"}]}"
            }
          ]
        },
        {
          "name": "Register Peer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('peerAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('peerUserId', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a second user (Bob) and stores `peerUserId` / `peerAccessToken` without overwriting Alice's session. Required before DMs and groups (accepted friendship)."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\"success\":true,\"data\":{\"accessToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"refreshToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"user\":{\"id\":\"507f1f77bcf86cd799439011\",\"name\":\"Bob\",\"email\":\"bob@example.com\",\"username\":\"bob.d4e5f6\",\"bio\":\"\",\"status\":\"online\"},\"message\":\"Registration successful.\"}}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates Alice. Returns access + refresh tokens and sets cookies. Generic 401 on bad credentials."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"accessToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"refreshToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"user\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"email\":\"alice@example.com\",\"username\":\"alice.a1b2c3\",\"bio\":\"\",\"status\":\"online\"},\"message\":\"Login successful.\"}}"
            },
            {
              "name": "401 Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"success\":false,\"message\":\"Invalid email or password.\",\"code\":\"AUTH_INVALID_CREDENTIALS\"}"
            }
          ]
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates the refresh token (same family) and issues a new access token. Body `refreshToken` or the `chat_rt` cookie. Reuse of a revoked refresh token revokes the whole family."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"accessToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"refreshToken\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"user\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"email\":\"alice@example.com\",\"status\":\"online\"}}}"
            },
            {
              "name": "401 Invalid refresh",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"success\":false,\"message\":\"Refresh token is no longer valid.\",\"code\":\"AUTH_TOKEN_INVALID\"}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Requires a valid access token. Persists the access JTI on a Mongo denylist (TTL) and revokes the refresh family. Clears auth cookies."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"message\":\"Logged out.\"}}"
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the authenticated user's sanitized profile."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"email\":\"alice@example.com\",\"username\":\"alice.a1b2c3\",\"bio\":\"\",\"avatar\":\"\",\"coverUrl\":\"\",\"status\":\"online\",\"createdAt\":\"2026-01-01T00:00:00.000Z\"}}"
            },
            {
              "name": "401 Unauthenticated",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"success\":false,\"message\":\"Authentication required.\",\"code\":\"AUTH_UNAUTHENTICATED\"}"
            },
            {
              "name": "401 Token expired",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"success\":false,\"message\":\"Token has expired.\",\"code\":\"AUTH_TOKEN_EXPIRED\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Search Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (Array.isArray(json.data) && json.data[0]?.id) {",
                  "    pm.collectionVariables.set('peerUserId', json.data[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/search?q=bo",
              "host": ["{{baseUrl}}"],
              "path": ["users", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "bo",
                  "description": "Min 2 characters. Matches displayName or username (not email). Empty/short queries return []. Max 20 results."
                }
              ]
            },
            "description": "Authenticated search. Excludes the current user. Regex is escaped server-side. Stores the first hit as `peerUserId`."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":[{\"id\":\"507f1f77bcf86cd799439011\",\"name\":\"Bob\",\"email\":\"bob@example.com\",\"username\":\"bob.d4e5f6\",\"bio\":\"\",\"avatar\":\"\",\"coverUrl\":\"\",\"status\":\"offline\"}]}"
            }
          ]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Same sanitizer as GET /auth/me."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"email\":\"alice@example.com\",\"username\":\"alice.a1b2c3\",\"bio\":\"\",\"avatar\":\"\",\"coverUrl\":\"\",\"status\":\"online\",\"createdAt\":\"2026-01-01T00:00:00.000Z\"}}"
            }
          ]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"bio\": \"Hello, I'm Alice!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Updates display name and/or bio. At least one field is required (422 otherwise)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice Smith\",\"email\":\"alice@example.com\",\"username\":\"alice.a1b2c3\",\"bio\":\"Hello, I'm Alice!\",\"status\":\"online\"}}"
            },
            {
              "name": "422 Empty body",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\"success\":false,\"message\":\"Invalid request payload\",\"code\":\"VALIDATION_ERROR\",\"details\":[{\"path\":\"\",\"message\":\"Provide a name or bio to update.\"}]}"
            }
          ]
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": [],
                  "description": "JPG, PNG, GIF, or WebP. Max 5 MB. SVG is rejected."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "avatar"]
            },
            "description": "Uploads a profile image. Stored under `/uploads/<uuid>.<ext>`. Fetching `/uploads/...` requires authentication."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"avatar\":\"/uploads/395889da-8134-4ff9-bd0b-a32baba1a149.png\"}}"
            }
          ]
        },
        {
          "name": "Upload Cover",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "cover",
                  "type": "file",
                  "src": [],
                  "description": "JPG, PNG, GIF, or WebP. Max 5 MB."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/cover",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "cover"]
            },
            "description": "Uploads a cover image. Same constraints as avatar."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\",\"coverUrl\":\"/uploads/ec15631a-2ca6-4b01-b9d1-9aecec98e420.png\"}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Friends",
      "item": [
        {
          "name": "Send Friend Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('friendRequestId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"{{peerUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/friends/request",
              "host": ["{{baseUrl}}"],
              "path": ["friends", "request"]
            },
            "description": "Alice sends a request to Bob (`peerUserId`). Cannot target yourself. Duplicate PENDING/ACCEPTED returns 409. REJECTED/CANCELLED can be resent."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\"success\":true,\"data\":{\"id\":\"507f1f77bcf86cd799439021\",\"status\":\"PENDING\",\"isRequester\":true,\"requester\":{\"id\":\"507f191e810c19729de860ea\",\"name\":\"Alice\"},\"recipient\":{\"id\":\"507f1f77bcf86cd799439011\",\"name\":\"Bob\"}}}"
            },
            {
              "name": "409 Already friends",
              "status": "Conflict",
              "code": 409,
              "body": "{\"success\":false,\"message\":\"You are already friends.\",\"code\":\"CONFLICT\"}"
            },
            {
              "name": "422 Self request",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\"success\":false,\"message\":\"You cannot send a friend request to yourself.\",\"code\":\"VALIDATION_ERROR\"}"
            }
          ]
        },
        {
          "name": "List Friends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends",
              "host": ["{{baseUrl}}"],
              "path": ["friends"]
            },
            "description": "Accepted friends of the current user (sanitized user objects)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":[{\"id\":\"507f1f77bcf86cd799439011\",\"name\":\"Bob\",\"email\":\"bob@example.com\",\"username\":\"bob.d4e5f6\",\"bio\":\"\",\"status\":\"offline\"}]}"
            }
          ]
        },
        {
          "name": "Incoming Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends/requests/incoming",
              "host": ["{{baseUrl}}"],
              "path": ["friends", "requests", "incoming"]
            },
            "description": "PENDING requests where the current user is the recipient."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":[{\"id\":\"507f1f77bcf86cd799439021\",\"status\":\"PENDING\",\"isRequester\":false}]}"
            }
          ]
        },
        {
          "name": "Sent Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends/requests/sent",
              "host": ["{{baseUrl}}"],
              "path": ["friends", "requests", "sent"]
            },
            "description": "PENDING requests the current user sent."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":[{\"id\":\"507f1f77bcf86cd799439021\",\"status\":\"PENDING\",\"isRequester\":true}]}"
            }
          ]
        },
        {
          "name": "Friendship Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends/status/{{peerUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["friends", "status", "{{peerUserId}}"]
            },
            "description": "Status vs another user: NONE | PENDING | ACCEPTED | REJECTED | CANCELLED, plus requestId and isRequester."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"success\":true,\"data\":{\"status\":\"PENDING\",\"requestId\":\"507f1f77bcf86cd799439021\",\"isRequester\":true}}"
            }
          ]
        },
        {
          "name": "Accept Friend Request",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
